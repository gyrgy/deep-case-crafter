{
  "name": "deep-case-crafter",
  "version": "3.2.0",
  "description": "Convert object keys between camelCase, snake_case, kebab-case and PascalCase, deeply (objects, arrays, Map, Set), with exact TypeScript types",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gyrgy/deep-case-crafter.git"
  },
  "bugs": {
    "url": "https://github.com/gyrgy/deep-case-crafter/issues"
  },
  "homepage": "https://github.com/gyrgy/deep-case-crafter#readme",
  "author": "gyrgy",
  "license": "MIT",
  "private": false,
  "keywords": [
    "camelCase",
    "snake_case",
    "kebab-case",
    "PascalCase",
    "camelcase",
    "snakecase",
    "kebabcase",
    "pascalcase",
    "camel-case",
    "snake-case",
    "case-convert",
    "convert-case",
    "case-conversion",
    "object-keys",
    "convert-keys",
    "transform-keys",
    "map-keys",
    "deep",
    "nested",
    "typescript"
  ],
  "scripts": {
    "build": "rollup -c",
    "prepack": "npm run build",
    "prepare": "husky",
    "test": "jest",
    "test-coverage": "npm test -- --coverage",
    "test:types": "tsc --noEmit",
    "tsc": "tsc --noEmit",
    "test:dist-types": "tsc -p dist-type-tests && tsc -p dist-type-tests/tsconfig.declarations.json && node dist-type-tests/checkDeclarations.mjs && tsc -p dist-type-tests/tsconfig.consumer.json && tsc -p dist-type-tests/tsconfig.loose.json && tsc -p dist-type-tests/tsconfig.exact.json",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src/ --max-warnings=0 --no-cache",
    "lint:fix": "eslint --ext .js,.jsx,.ts,.tsx src/ --fix --max-warnings=0 --no-cache",
    "format": "prettier --write src dist-type-tests benchmark .github readme.md CHANGELOG.md SECURITY.md",
    "format:check": "prettier --check src dist-type-tests benchmark .github readme.md CHANGELOG.md SECURITY.md",
    "benchmark": "tsx benchmark/*.benchmark.ts",
    "check": "npm run lint && npm run format:check && npm run test:types && npm run test-coverage && npm run build && npm run test:dist-types"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/benchmark": "2.1.5",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.1",
    "benchmark": "2.1.4",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "lint-staged": "17.0.7",
    "rollup": "4.61.0",
    "rollup-plugin-dts": "6.4.1",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "rollup-plugin-visualizer": "7.0.1",
    "ts-jest": "29.4.11",
    "tslib": "2.8.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1"
  }
}
